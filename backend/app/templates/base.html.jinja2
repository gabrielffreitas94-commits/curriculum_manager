<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ThothCVs AI{% endblock %}</title>

    <!-- Script Anti-FOUC (Prevenção de Flash de Tema) -->
    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Tailwind CSS Compilado -->
    <link rel="stylesheet" href="/static/css/styles.css?v=2">

    <!-- HTMX -->
    <script src="/static/js/htmx.min.js"></script>

    <!-- Favicon -->
    <link rel="icon" href="/static/img/logo.jpg" type="image/jpeg">

    {% block head %}{% endblock %}
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <!-- 1. HEADER FIXO -->
    <header class="w-full border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo / Branding -->
            <a href="/" class="flex items-center space-x-2.5 text-lg font-bold tracking-tight">
                <img src="/static/img/logo.jpg" alt="Logo ThothSCV" class="w-8 h-8 rounded-lg object-contain">
                <span>ThothSCV</span>
            </a>

            <!-- Ações e Tema -->
            <div class="flex items-center space-x-4">
                <button 
                    type="button" 
                    id="theme-toggle"
                    role="switch"
                    aria-checked="false"
                    aria-label="Alternar modo escuro e claro"
                    onclick="toggleTheme()" 
                    class="relative flex items-center w-[132px] h-10 px-1 rounded-full border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-800 transition-colors duration-300 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-slate-400">
                    
                    <!-- Texto DARK MODE (visível no modo escuro, posicionado à esquerda) -->
                    <span class="absolute left-3.5 text-[10px] font-bold tracking-wider uppercase text-slate-300 opacity-0 dark:opacity-100 transition-opacity duration-300 pointer-events-none">
                        DARK MODE
                    </span>

                    <!-- Texto LIGHT MODE (visível no modo claro, posicionado à direita) -->
                    <span class="absolute right-3.5 text-[10px] font-bold tracking-wider uppercase text-slate-600 opacity-100 dark:opacity-0 transition-opacity duration-300 pointer-events-none">
                        LIGHT MODE
                    </span>

                    <!-- Botão Deslizante Branco (Thumb) -->
                    <span class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full bg-white shadow-md transform transition-transform duration-300 ease-in-out dark:translate-x-[92px]">
                        <!-- Ícone Sol (Modo Claro) -->
                        <svg class="w-4 h-4 text-slate-600 block dark:hidden transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>

                        <!-- Ícone Lua com Estrelinhas (Modo Escuro) -->
                        <svg class="w-4 h-4 text-slate-700 hidden dark:block transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
                            <path d="M19 3l.8 1.7L21.5 5.5l-1.7.8L19 8l-.8-1.7-1.7-.8 1.7-.8L19 3z"></path>
                            <path d="M14 1l.5 1.1 1.1.5-1.1.5-.5 1.1-.5-1.1-1.1-.5 1.1-.5.5-1.1z"></path>
                        </svg>
                    </span>
                </button>
            </div>
        </div>
    </header>

    <!-- 2. CENTRO DINÂMICO (Área que o HTMX substitui) -->
    <main id="main-content" class="flex-grow flex flex-col items-center justify-center p-6">
        {% block content %}{% endblock %}
    </main>

    <!-- 3. CONTAINER GLOBAL DE MODAIS (Vazio por padrão) -->
    <div id="modal-container"></div>

    <!-- 4. FOOTER FIXO -->
    <footer class="w-full border-t border-slate-200 dark:border-slate-800 py-4 text-center text-xs text-slate-500 dark:text-slate-500">
        <p>© 2026 ThothCVs AI — Gestão Inteligente com FastAPI + HTMX</p>
    </footer>

    <!-- Script Global de Controle do Tema -->
    <script>
        function updateToggleAria(isDark) {
            const toggleBtn = document.getElementById('theme-toggle');
            if (toggleBtn) {
                toggleBtn.setAttribute('aria-checked', isDark ? 'true' : 'false');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.theme = isDark ? 'dark' : 'light';
            updateToggleAria(isDark);
        }

        document.addEventListener('DOMContentLoaded', () => {
            updateToggleAria(document.documentElement.classList.contains('dark'));
        });
    </script>
</body>
</html>
