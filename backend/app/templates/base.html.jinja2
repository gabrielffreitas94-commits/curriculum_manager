<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ThothCVs AI{% endblock %}</title>

    <!-- Script Anti-FOUC (Prevenção de Flash de Tema) -->
    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Tailwind CSS Compilado -->
    <link rel="stylesheet" href="/static/css/styles.css?v=2">

    <!-- HTMX -->
    <script src="/static/js/htmx.min.js"></script>

    <!-- Favicon -->
    <link rel="icon" href="/static/img/logo.jpg" type="image/jpeg">

    {% block head %}{% endblock %}
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <!-- 1. HEADER FIXO -->
    <header class="w-full border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo / Branding -->
            <a href="/" class="flex items-center space-x-2.5 text-lg font-bold tracking-tight">
                <img src="/static/img/logo.jpg" alt="Logo ThothSCV" class="w-8 h-8 rounded-lg object-contain">
                <span>ThothSCV</span>
            </a>

            <!-- Ações: Dropdown de Idioma e Tema -->
            <div class="flex items-center space-x-3">
                <!-- Dropdown de Idioma -->
                <div class="relative" id="lang-dropdown-container">
                    <button 
                        type="button" 
                        id="lang-dropdown-btn"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-label="Selecionar idioma da interface"
                        onclick="toggleLangDropdown()" 
                        class="flex items-center gap-1.5 h-8 px-2.5 rounded-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-750 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400 cursor-pointer">
                        
                        <!-- Ícone Globo -->
                        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>

                        <span id="current-lang-label" class="font-semibold text-[11px]">PT-BR</span>

                        <!-- Chevron -->
                        <svg id="lang-dropdown-chevron" class="w-3 h-3 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>

                    <!-- Menu Flutuante -->
                    <div 
                        id="lang-dropdown-menu" 
                        role="menu"
                        aria-orientation="vertical"
                        class="hidden absolute right-0 mt-1.5 w-44 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl py-1 z-50 text-xs text-slate-700 dark:text-slate-200 divide-y divide-slate-100 dark:divide-slate-800">
                        
                        <div class="py-1">
                            <button type="button" role="menuitem" onclick="changeLocale('pt-BR', 'PT-BR')" class="w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                <span>Português (Brasil)</span>
                                <span class="text-[10px] text-slate-400 font-mono">pt-BR</span>
                            </button>
                            <button type="button" role="menuitem" onclick="changeLocale('pt-PT', 'PT-PT')" class="w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                <span>Português (Portugal)</span>
                                <span class="text-[10px] text-slate-400 font-mono">pt-PT</span>
                            </button>
                        </div>
                        <div class="py-1">
                            <button type="button" role="menuitem" onclick="changeLocale('en-US', 'EN-US')" class="w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                <span>English (US)</span>
                                <span class="text-[10px] text-slate-400 font-mono">en-US</span>
                            </button>
                            <button type="button" role="menuitem" onclick="changeLocale('en-GB', 'EN-GB')" class="w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                <span>English (UK)</span>
                                <span class="text-[10px] text-slate-400 font-mono">en-GB</span>
                            </button>
                        </div>
                        <div class="py-1">
                            <button type="button" role="menuitem" onclick="changeLocale('es-ES', 'ES-ES')" class="w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                <span>Español</span>
                                <span class="text-[10px] text-slate-400 font-mono">es-ES</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Botão Alternador Dark/Light (Redimensionado e Proporcional) -->
                <button 
                    type="button" 
                    id="theme-toggle"
                    role="switch"
                    aria-checked="false"
                    aria-label="Alternar modo escuro e claro"
                    onclick="toggleTheme()" 
                    class="relative flex items-center w-[108px] h-8 p-1 rounded-full border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-800 transition-colors duration-300 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-slate-400">
                    
                    <!-- Texto DARK MODE (visível no modo escuro, posicionado à esquerda) -->
                    <span class="absolute left-2.5 text-[8.5px] font-bold tracking-wider uppercase text-slate-300 opacity-0 dark:opacity-100 transition-opacity duration-300 pointer-events-none">
                        DARK MODE
                    </span>

                    <!-- Texto LIGHT MODE (visível no modo claro, posicionado à direita) -->
                    <span class="absolute right-2.5 text-[8.5px] font-bold tracking-wider uppercase text-slate-600 opacity-100 dark:opacity-0 transition-opacity duration-300 pointer-events-none">
                        LIGHT MODE
                    </span>

                    <!-- Botão Deslizante Branco (Thumb) -->
                    <span class="relative z-10 flex items-center justify-center w-6 h-6 rounded-full bg-white shadow-md transform transition-transform duration-300 ease-in-out dark:translate-x-[76px]">
                        <!-- Ícone Sol (Modo Claro) -->
                        <svg class="w-3.5 h-3.5 text-slate-600 block dark:hidden transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>

                        <!-- Ícone Lua com Estrelinhas (Modo Escuro) -->
                        <svg class="w-3.5 h-3.5 text-slate-700 hidden dark:block transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
                            <path d="M19 3l.8 1.7L21.5 5.5l-1.7.8L19 8l-.8-1.7-1.7-.8 1.7-.8L19 3z"></path>
                            <path d="M14 1l.5 1.1 1.1.5-1.1.5-.5 1.1-.5-1.1-1.1-.5 1.1-.5.5-1.1z"></path>
                        </svg>
                    </span>
                </button>

                <!-- Autenticação / Usuário no Header -->
                {% include "components/header_auth.html.jinja2" %}
            </div>
        </div>
    </header>

    <!-- 2. CENTRO DINÂMICO (Área que o HTMX substitui) -->
    <main id="main-content" class="flex-grow flex flex-col items-center justify-center p-6">
        {% block content %}{% endblock %}
    </main>

    <!-- 3. CONTAINER GLOBAL DE MODAIS (Vazio por padrão) -->
    <div id="modal-container"></div>

    <!-- 4. FOOTER FIXO -->
    <footer class="w-full border-t border-slate-200 dark:border-slate-800 py-4 text-center text-xs text-slate-500 dark:text-slate-500">
        <p>© 2026 ThothCVs AI — Gestão Inteligente com FastAPI + HTMX</p>
    </footer>

    <!-- Script Global de Controle do Tema e Idioma -->
    <script>
        // --- Tema (Dark/Light) ---
        function updateToggleAria(isDark) {
            const toggleBtn = document.getElementById('theme-toggle');
            if (toggleBtn) {
                toggleBtn.setAttribute('aria-checked', isDark ? 'true' : 'false');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.theme = isDark ? 'dark' : 'light';
            updateToggleAria(isDark);
        }

        // --- Idioma (Dropdown) ---
        function toggleLangDropdown() {
            const menu = document.getElementById('lang-dropdown-menu');
            const btn = document.getElementById('lang-dropdown-btn');
            const chevron = document.getElementById('lang-dropdown-chevron');
            if (!menu || !btn) return;
            const isHidden = menu.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', !isHidden ? 'true' : 'false');
            if (chevron) {
                chevron.classList.toggle('rotate-180', !isHidden);
            }
        }

        function changeLocale(code, label) {
            localStorage.setItem('locale', code);
            document.cookie = `locale=${encodeURIComponent(code)};path=/;max-age=31536000;SameSite=Lax`;
            const labelElem = document.getElementById('current-lang-label');
            if (labelElem) {
                labelElem.textContent = label;
            }
            const menu = document.getElementById('lang-dropdown-menu');
            const btn = document.getElementById('lang-dropdown-btn');
            const chevron = document.getElementById('lang-dropdown-chevron');
            if (menu) menu.classList.add('hidden');
            if (btn) btn.setAttribute('aria-expanded', 'false');
            if (chevron) chevron.classList.remove('rotate-180');
        }

        // --- Modal Helper ---
        function closeModal() {
            const container = document.getElementById('modal-container');
            if (container) {
                container.innerHTML = '';
            }
        }

        // Fechar dropdown de idioma e modal ao clicar fora ou pressionar Escape
        document.addEventListener('click', (e) => {
            const container = document.getElementById('lang-dropdown-container');
            if (container && !container.contains(e.target)) {
                const menu = document.getElementById('lang-dropdown-menu');
                const btn = document.getElementById('lang-dropdown-btn');
                const chevron = document.getElementById('lang-dropdown-chevron');
                if (menu) menu.classList.add('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'false');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeModal();
                const menu = document.getElementById('lang-dropdown-menu');
                const btn = document.getElementById('lang-dropdown-btn');
                const chevron = document.getElementById('lang-dropdown-chevron');
                if (menu) menu.classList.add('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'false');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        });

        // Inicialização de Tema e Idioma ao carregar DOM
        document.addEventListener('DOMContentLoaded', () => {
            updateToggleAria(document.documentElement.classList.contains('dark'));
            const savedLocale = localStorage.getItem('locale') || 'pt-BR';
            const labelElem = document.getElementById('current-lang-label');
            if (labelElem) {
                labelElem.textContent = savedLocale.toUpperCase();
            }
        });
    </script>
</body>
</html>
