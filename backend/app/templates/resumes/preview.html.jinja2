  function removeExperienceCard(btn) {
    var card = btn.closest('.experience-card');
    if (!card) return;

    var company = (card.dataset.company || card.querySelector('[name*="_company"]')?.value || '').toLowerCase().trim();
    var title = (card.dataset.title || card.querySelector('[name*="_title"]')?.value || '').toLowerCase().trim();
    var dossierIdx = card.dataset.dossierIdx;

    card.remove();

    var nums = document.querySelectorAll('.exp-number');
    nums.forEach(function(el, i) { el.innerText = (i + 1); });

    var countBadge = document.getElementById('exp-count-badge');
    var container = document.getElementById('experiences-container');
    if (countBadge && container) {
      countBadge.innerText = container.querySelectorAll('.experience-card').length;
    }

    var dossierButtons = document.querySelectorAll('[id^="btn-add-exp-"]');
    dossierButtons.forEach(function(dBtn) {
      var dCompany = (dBtn.dataset.company || '').toLowerCase().trim();
      var dTitle = (dBtn.dataset.title || '').toLowerCase().trim();
      var dIdx = dBtn.dataset.dossierIdx;

      if ((dossierIdx !== undefined && dIdx === dossierIdx) || (dCompany === company && dTitle === title)) {
        dBtn.dataset.included = 'false';
        dBtn.innerHTML = '➕ Incluir';
        dBtn.title = 'Clique para incluir esta experiência no currículo.';
        dBtn.className = 'px-2.5 py-1 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 shadow-2xs font-semibold text-[11px] transition-colors cursor-pointer';
        
        var bIdx = dBtn.id.replace('btn-add-exp-', '');
        var badge = document.getElementById('badge-included-exp-' + bIdx);
        if (badge) badge.classList.add('hidden');
      }
    });

    var form = document.getElementById('resume-editor-form');
    if (form) { htmx.trigger(form, 'input'); }
  }

