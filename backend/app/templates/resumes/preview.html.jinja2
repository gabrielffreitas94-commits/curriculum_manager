  // Adiciona competência à lista
  function addSkillToResume(skillName) {
    var input = document.getElementById('input-skills');
    if (!input) return;
    var current = input.value.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
    if (!current.includes(skillName)) {
      current.push(skillName);
      input.value = current.join(', ');
      var form = document.getElementById('resume-editor-form');
      if (form) { htmx.trigger(form, 'input'); }
    }
  }

  // Disparo de persistência manual
  document.body.addEventListener('saveResume', function() {
    var form = document.getElementById('resume-editor-form');
    if (!form) return;
    htmx.ajax('POST', '/resumes/{{ resume.id }}/save', {
      source: form,
      target: '#save-feedback',
      swap: 'innerHTML'
    }).then(function() {
      var indicator = document.getElementById('top-save-indicator');
      var text = document.getElementById('top-save-text');
      if (indicator && text) {
        indicator.className = 'inline-flex items-center gap-1.5 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800';
        text.innerText = 'Salvo';
      }
    });
  });

  // Inicialização de abas por URL (?tab=editor) e mensagens de tradução
  document.addEventListener('DOMContentLoaded', function() {
    var params = new URLSearchParams(window.location.search);
    var tab = params.get('tab');
    if (tab && ['job', 'editor', 'copilot', 'dossier'].includes(tab)) {
      switchStudioTab(tab);
    }
    if (params.get('translated') === '1') {
      var feedback = document.getElementById('save-feedback');
      if (feedback) {
        feedback.innerHTML = `
          <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-xs font-semibold text-emerald-800 dark:text-emerald-300 flex items-center justify-between animate-in fade-in">
            <span>✅ Currículo traduzido com sucesso para o idioma selecionado!</span>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 font-bold ml-2 cursor-pointer">&times;</button>
          </div>
        `;
      }
    }
  });
