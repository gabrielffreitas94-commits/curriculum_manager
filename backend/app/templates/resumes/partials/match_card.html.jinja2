<div id="match-analysis-container" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-800">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
        <span>🎯</span> Avaliação de Aderência & Match ATS
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Comparação semântica algorítmica entre seu Dossiê Mestre e os requisitos da oportunidade.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <div class="text-right">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 block">Fit Geral</span>
        <span class="text-2xl font-black {% if match_result.match_percentage >= 75 %}text-emerald-600 dark:text-emerald-400{% elif match_result.match_percentage >= 50 %}text-amber-500 dark:text-amber-400{% else %}text-rose-500 dark:text-rose-400{% endif %}">
          {{ "%.1f"|format(match_result.match_percentage) }}%
        </span>
      </div>
      <div class="w-14 h-14 rounded-full flex items-center justify-center p-1.5 {% if match_result.match_percentage >= 75 %}bg-emerald-50 text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400{% elif match_result.match_percentage >= 50 %}bg-amber-50 text-amber-500 dark:bg-amber-950 dark:text-amber-400{% else %}bg-rose-50 text-rose-500 dark:bg-rose-950 dark:text-rose-400{% endif %}">
        <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
          <path class="stroke-current opacity-20" stroke-width="3.8" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
          <path class="stroke-current" stroke-dasharray="{{ match_result.match_percentage }}, 100" stroke-width="3.8" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Barra de progresso acessível -->
  <div class="space-y-1.5" role="progressbar" aria-valuenow="{{ match_result.match_percentage }}" aria-valuemin="0" aria-valuemax="100" aria-label="Porcentagem de aderência à vaga">
    <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2.5 overflow-hidden">
      <div class="h-2.5 rounded-full transition-all duration-500 {% if match_result.match_percentage >= 75 %}bg-emerald-500{% elif match_result.match_percentage >= 50 %}bg-amber-500{% else %}bg-rose-500{% endif %}" style="width: {{ match_result.match_percentage }}%"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
    <!-- Requisitos Mandatórios Atendidos -->
    <div class="space-y-3">
      <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5">
        <span>✅</span> Requisitos Atendidos ({{ match_result.mandatory_matches|length }})
      </h4>
      {% if match_result.mandatory_matches %}
        <div class="flex flex-wrap gap-1.5">
          {% for m in match_result.mandatory_matches %}
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" title="Evidência: {{ m.evidence }}">
              {{ m.requirement }}
            </span>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-xs text-slate-400 italic">Nenhum requisito mandatório expressamente identificado no dossiê.</p>
      {% endif %}
    </div>

    <!-- Lacunas / Requisitos Ausentes -->
    <div class="space-y-3">
      <h4 class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 flex items-center gap-1.5">
        <span>⚠️</span> Lacunas Identificadas ({{ match_result.missing_mandatory|length }})
      </h4>
      {% if match_result.missing_mandatory %}
        <div class="flex flex-wrap gap-1.5">
          {% for m in match_result.missing_mandatory %}
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-950/70 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
              {{ m }}
            </span>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">Parabéns! Todas as competências mandatórias foram encontradas no seu dossiê.</p>
      {% endif %}
    </div>
  </div>

  <!-- Requisitos Desejáveis e Palavras-chave -->
  <div class="pt-4 border-t border-slate-100 dark:border-slate-800 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <span class="text-xs font-bold text-slate-700 dark:text-slate-300 block">Diferenciais & Requisitos Desejáveis:</span>
      {% if match_result.desirable_matches or match_result.missing_desirable %}
        <div class="flex flex-wrap gap-1.5">
          {% for d in match_result.desirable_matches %}
            <span class="px-2 py-0.5 rounded text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              + {{ d.requirement }}
            </span>
          {% endfor %}
          {% for d in match_result.missing_desirable %}
            <span class="px-2 py-0.5 rounded text-xs bg-slate-50 dark:bg-slate-900 text-slate-400 border border-dashed border-slate-200 dark:border-slate-800">
              {{ d }}
            </span>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-xs text-slate-400 italic">Nenhum diferencial listado.</p>
      {% endif %}
    </div>

    <div class="space-y-2">
      <span class="text-xs font-bold text-indigo-700 dark:text-indigo-400 block">Termos & Palavras-chave ATS Sugeridas:</span>
      {% if match_result.suggested_keywords %}
        <div class="flex flex-wrap gap-1.5">
          {% for kw in match_result.suggested_keywords %}
            <span class="px-2 py-0.5 rounded text-xs font-mono bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-900">
              #{{ kw }}
            </span>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-xs text-slate-400 italic">Termos ATS processados automaticamente na síntese.</p>
      {% endif %}
    </div>
  </div>
</div>
