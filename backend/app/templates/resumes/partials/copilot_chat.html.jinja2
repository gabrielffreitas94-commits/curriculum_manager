<div id="copilot-chat-container" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm flex flex-col h-[560px]">
  <!-- Cabeçalho do Copilot -->
  <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl font-bold">
        🤖
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
          Copilot Estratégico de IA
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            Online
          </span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Metodologia ativa: <span class="font-semibold text-indigo-600 dark:text-indigo-400 uppercase font-mono">{{ prompt_skill_slug or 'google-xyz' }}</span>
        </p>
      </div>
    </div>
    <div class="text-xs text-slate-400 dark:text-slate-500 hidden sm:block">
      Baseado no seu Dossiê Mestre
    </div>
  </div>

  <!-- Feed de Mensagens Rolável -->
  <div id="copilot-messages-box" class="flex-1 overflow-y-auto space-y-4 py-4 pr-1" role="log" aria-live="polite" aria-label="Histórico de mensagens com o Copilot">
    {% if not messages %}
      <!-- Estado Inicial com Boas-vindas e Sugestões Rápidas -->
      <div class="bg-slate-50 dark:bg-slate-800/50 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-700/60 space-y-3">
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          👋 <strong>Olá!</strong> Sou seu copiloto de personalização. Posso ajudar você a adaptar suas experiências reais, aplicar a metodologia <em>{{ prompt_skill_slug or 'Google XYZ' }}</em> para quantificar impacto, e fechar lacunas com a vaga sem inventar fatos.
        </p>
        <div class="space-y-1.5 pt-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block">
            Sugestões de perguntas:
          </span>
          <div class="flex flex-wrap gap-2">
            <button type="button" 
                    onclick="setCopilotMessage(this.innerText)"
                    class="px-2.5 py-1.5 rounded-lg text-xs bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-600 transition-colors text-left cursor-pointer">
              Como enfatizar meus resultados com a metodologia Google XYZ?
            </button>
            <button type="button" 
                    onclick="setCopilotMessage(this.innerText)"
                    class="px-2.5 py-1.5 rounded-lg text-xs bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-600 transition-colors text-left cursor-pointer">
              Quais experiências do meu dossiê cobrem as lacunas da vaga?
            </button>
            <button type="button" 
                    onclick="setCopilotMessage(this.innerText)"
                    class="px-2.5 py-1.5 rounded-lg text-xs bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-600 transition-colors text-left cursor-pointer">
              Sugira melhorias nos bullets da minha última experiência
            </button>
          </div>
        </div>
      </div>
    {% endif %}

    {% for msg in messages %}
      {% if msg.role == 'user' %}
        <!-- Mensagem do Candidato -->
        <div class="flex justify-end">
          <div class="bg-indigo-600 text-white rounded-2xl rounded-tr-xs px-4 py-2.5 max-w-[85%] text-xs sm:text-sm shadow-xs leading-relaxed whitespace-pre-line">
            {{ msg.content }}
          </div>
        </div>
      {% else %}
        <!-- Mensagem do Copilot -->
        <div class="flex items-start gap-2.5 max-w-[90%]">
          <div class="w-7 h-7 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5">
            🤖
          </div>
          <div class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 rounded-2xl rounded-tl-xs px-4 py-3 text-xs sm:text-sm shadow-xs leading-relaxed whitespace-pre-line">
            {{ msg.content }}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <!-- Indicador de Carregamento com HTMX -->
    <div id="copilot-loading" class="htmx-indicator flex items-center gap-2 text-xs text-indigo-600 dark:text-indigo-400 py-2">
      <span class="animate-spin text-sm">⟳</span>
      <span>O Copilot está analisando o dossiê e formulando a estratégia...</span>
    </div>

    {% if error_message %}
      <div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-900 text-xs text-rose-700 dark:text-rose-300">
        ⚠️ {{ error_message }}
      </div>
    {% endif %}
  </div>

  <!-- Formulário de Envio do Chat -->
  <form 
    id="copilot-form" 
    hx-post="/resumes/copilot-chat" 
    hx-target="#copilot-chat-container" 
    hx-swap="outerHTML" 
    hx-indicator="#copilot-loading"
    class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2">
    
    <input type="hidden" name="history_json" value="{{ history_json | default('[]') | e }}">
    <input type="hidden" id="chat-job-desc" name="job_description" value="{{ job_description | default('') | e }}">
    <input type="hidden" id="chat-skill-slug" name="prompt_skill_slug" value="{{ prompt_skill_slug | default('google-xyz') }}">

    <div class="flex-1 relative">
      <input 
        type="text" 
        id="copilot-input-field"
        name="message" 
        placeholder="Pergunte ao Copilot sobre como otimizar seu currículo para esta vaga..." 
        required 
        autocomplete="off"
        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-xs sm:text-sm text-slate-900 dark:text-slate-100 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-slate-400">
    </div>

    <button 
      type="submit" 
      aria-label="Enviar mensagem para o Copilot de IA"
      class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-semibold transition-all shadow-xs flex items-center gap-1.5 cursor-pointer disabled:opacity-50">
      <span>Enviar</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </button>
  </form>

  <script>
    (function() {
      var box = document.getElementById('copilot-messages-box');
      if (box) { box.scrollTop = box.scrollHeight; }
      var field = document.getElementById('copilot-input-field');
      if (field) { field.focus(); }
    })();

    function setCopilotMessage(text) {
      var field = document.getElementById('copilot-input-field');
      if (field) {
        field.value = text;
        field.focus();
      }
    }
  </script>
</div>
