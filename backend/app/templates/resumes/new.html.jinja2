{% extends "base.html.jinja2" %}

{% block title %}Criar Currículo Sob Medida — ThothCVs AI{% endblock %}

{% block main_class %}w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8{% endblock %}

{% block content %}
<div class="space-y-8">
  <!-- Topo da Página -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100 flex items-center gap-2">
        <span>✨</span> Gerador de Currículo Sob Medida
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
        Personalize seu currículo com inteligência artificial, metodologias consagradas e ancoragem estrita no seu Dossiê Mestre.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/profile" class="px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
        📝 Ver Dossiê Mestre
      </a>
    </div>
  </div>

  <!-- Layout Principal em Grid Responsivo -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- COLUNA DA ESQUERDA: Ingestão de Vaga, Metodologia e Ações (7 colunas) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- 1. CARD DE INGESTÃO DA VAGA -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
          <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 text-xs flex items-center justify-center font-bold">1</span>
            Oportunidade Alvo (Job Description)
          </h2>
          <span class="text-[11px] text-slate-400 dark:text-slate-500">PDF, DOCX, URL ou Texto</span>
        </div>

        <!-- Abas de Ingestão -->
        <div class="flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-slate-800/80 rounded-xl text-xs font-semibold" role="tablist">
          <button type="button" 
                  id="tab-btn-text" 
                  role="tab" 
                  aria-selected="true" 
                  aria-controls="panel-text"
                  onclick="switchIngestTab('text')" 
                  class="flex-1 py-1.5 px-3 rounded-lg transition-all bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs cursor-pointer">
            ✍️ Colar Texto
          </button>
          <button type="button" 
                  id="tab-btn-url" 
                  role="tab" 
                  aria-selected="false" 
                  aria-controls="panel-url"
                  onclick="switchIngestTab('url')" 
                  class="flex-1 py-1.5 px-3 rounded-lg transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer">
            🔗 Link da Vaga (URL)
          </button>
          <button type="button" 
                  id="tab-btn-doc" 
                  role="tab" 
                  aria-selected="false" 
                  aria-controls="panel-doc"
                  onclick="switchIngestTab('doc')" 
                  class="flex-1 py-1.5 px-3 rounded-lg transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer">
            📄 Upload PDF/DOCX
          </button>
        </div>

        <!-- Painel URL Scraping -->
        <div id="panel-url" class="hidden space-y-3 p-4 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200/80 dark:border-slate-700/60" role="tabpanel">
          <form 
            id="url-scrape-form"
            hx-post="/resumes/scrape-job-url" 
            hx-target="#job-desc-feedback" 
            hx-indicator="#url-scrape-spinner"
            class="flex flex-col sm:flex-row gap-2">
            <input 
              type="url" 
              name="url" 
              placeholder="https://exemplo.com/vagas/senior-engineer" 
              required
              class="flex-1 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs sm:text-sm text-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:outline-hidden">
            <button 
              type="submit" 
              class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1.5 shadow-xs cursor-pointer">
              <span>Extrair Texto</span>
              <span id="url-scrape-spinner" class="htmx-indicator animate-spin">⟳</span>
            </button>
          </form>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            🛡️ Proteção anti-SSRF ativa com validação de hosts e limite de download.
          </p>
        </div>

        <!-- Painel Document Upload -->
        <div id="panel-doc" class="hidden space-y-3 p-4 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200/80 dark:border-slate-700/60" role="tabpanel">
          <form 
            id="doc-upload-form"
            hx-post="/resumes/upload-job-doc" 
            hx-encoding="multipart/form-data" 
            hx-target="#job-desc-feedback" 
            hx-indicator="#doc-upload-spinner"
            class="flex flex-col sm:flex-row gap-2">
            <input 
              type="file" 
              name="file" 
              accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" 
              required
              class="flex-1 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs text-slate-700 dark:text-slate-300 file:mr-3 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 dark:file:bg-indigo-950 dark:file:text-indigo-300">
            <button 
              type="submit" 
              class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1.5 shadow-xs cursor-pointer">
              <span>Processar Doc</span>
              <span id="doc-upload-spinner" class="htmx-indicator animate-spin">⟳</span>
            </button>
          </form>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Formatos suportados: PDF nativo ou Word (.docx) com até 5 MB.
          </p>
        </div>

        <!-- Área de feedback / erro para upload ou scraper -->
        <div id="job-desc-feedback"></div>

        <!-- Textarea Central da Descrição da Vaga -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
            <label for="job-description-input" class="font-semibold text-slate-700 dark:text-slate-300">
              Conteúdo da Vaga
            </label>
            <span id="job-char-counter">0 caracteres</span>
          </div>
          <textarea 
            id="job-description-input" 
            name="job_description" 
            rows="8" 
            placeholder="Cole aqui a descrição completa da vaga, requisitos mandatórios, desejáveis e informações da empresa..." 
            oninput="handleJobDescriptionChange(this.value)"
            class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-xs sm:text-sm text-slate-900 dark:text-slate-100 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-slate-400 font-mono leading-relaxed"></textarea>
        </div>
      </div>

      <!-- 2. CARD DE METODOLOGIAS (PROMPT SKILLS) -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
          <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 text-xs flex items-center justify-center font-bold">2</span>
            Metodologia de Confecção & Tom de Voz
          </h2>
          <span class="text-[11px] text-indigo-600 dark:text-indigo-400 font-semibold">Prompt Skills</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Selecione a metodologia de confecção do currículo">
          <!-- Google XYZ -->
          <label class="relative flex flex-col p-3.5 rounded-xl border-2 cursor-pointer transition-all border-indigo-600 bg-indigo-50/50 dark:bg-indigo-950/30 dark:border-indigo-500 skill-card" id="card-google-xyz">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">Google XYZ</span>
              <input type="radio" name="methodology_choice" value="google-xyz" checked onchange="selectSkill('google-xyz')" class="accent-indigo-600">
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-1 leading-normal">
              "Accomplished [X] as measured by [Y], by doing [Z]". Foco absoluto em métricas e resultados de impacto.
            </p>
          </label>

          <!-- STAR Method -->
          <label class="relative flex flex-col p-3.5 rounded-xl border-2 cursor-pointer transition-all border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 skill-card" id="card-star-method">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">Método STAR</span>
              <input type="radio" name="methodology_choice" value="star-method" onchange="selectSkill('star-method')" class="accent-indigo-600">
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-1 leading-normal">
              Situação, Tarefa, Ação e Resultado mensurável. Ideal para narrativas de resolução de problemas complexos.
            </p>
          </label>

          <!-- Tech Startup -->
          <label class="relative flex flex-col p-3.5 rounded-xl border-2 cursor-pointer transition-all border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 skill-card" id="card-tech-startup">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">Tech Startup</span>
              <input type="radio" name="methodology_choice" value="tech-startup" onchange="selectSkill('tech-startup')" class="accent-indigo-600">
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-1 leading-normal">
              Velocidade, ownership ponta-a-ponta, tolerância a ambiguidade, escala rápida e stack moderna.
            </p>
          </label>

          <!-- Enterprise & Gov -->
          <label class="relative flex flex-col p-3.5 rounded-xl border-2 cursor-pointer transition-all border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 skill-card" id="card-enterprise-gov">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">Enterprise & Gov</span>
              <input type="radio" name="methodology_choice" value="enterprise-gov" onchange="selectSkill('enterprise-gov')" class="accent-indigo-600">
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-1 leading-normal">
              Governança, compliance estrito, estabilidade operacional, segurança e redução sistemática de riscos.
            </p>
          </label>

          <!-- Executive Leadership -->
          <label class="relative flex flex-col p-3.5 rounded-xl border-2 cursor-pointer transition-all border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 skill-card sm:col-span-2" id="card-executive-leadership">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">Executive Leadership</span>
              <input type="radio" name="methodology_choice" value="executive-leadership" onchange="selectSkill('executive-leadership')" class="accent-indigo-600">
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-1 leading-normal">
              Visão estratégica de negócios, liderança de equipes multidisciplinares, orçamento/P&L e expansão corporativa.
            </p>
          </label>
        </div>
      </div>

      <!-- 3. BARRA DE AÇÃO PRINCIPAL -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <form 
          id="match-analysis-form"
          hx-post="/resumes/analyze-match" 
          hx-target="#match-analysis-container" 
          hx-swap="outerHTML" 
          hx-indicator="#match-spinner"
          class="w-full sm:w-auto flex-1">
          <input type="hidden" id="match-job-desc" name="job_description" value="">
          <button 
            type="submit" 
            class="w-full py-3 px-5 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50/80 dark:bg-indigo-950/50 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 text-xs sm:text-sm font-bold transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer">
            <span>🎯 Avaliar Aderência com Dossiê</span>
            <span id="match-spinner" class="htmx-indicator animate-spin">⟳</span>
          </button>
        </form>

        <button 
          type="button" 
          onclick="triggerResumeSynthesis()"
          class="w-full sm:w-auto py-3 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-bold transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer">
          <span>✨ Gerar Currículo Sob Medida</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>
      </div>

    </div>

    <!-- COLUNA DA DIREITA: Match Analysis & Copilot Chat Interativo (5 colunas) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Container de Análise de Aderência (Estado Inicial) -->
      <div id="match-analysis-container" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-3">
        <div class="flex items-center gap-2.5 text-slate-900 dark:text-slate-100 font-bold text-sm">
          <span>🎯</span> Avaliação de Aderência & Match ATS
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Cole a descrição da vaga ou faça o upload ao lado e clique em <strong>"Avaliar Aderência com Dossiê"</strong> para calcular a correspondência semântica e detectar lacunas em tempo real.
        </p>
        <div class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200/80 dark:border-slate-700/60 flex items-center gap-2 text-[11px] text-slate-600 dark:text-slate-400">
          <span>💡</span> O cálculo compara suas experiências reais cadastradas com as competências da oportunidade.
        </div>
      </div>

      <!-- Container do Copilot Chat Interativo -->
      {% include "resumes/partials/copilot_chat.html.jinja2" %}

    </div>

  </div>
</div>

<script>
  let activeSkill = 'google-xyz';

  function switchIngestTab(tab) {
    var panelUrl = document.getElementById('panel-url');
    var panelDoc = document.getElementById('panel-doc');
    var btnText = document.getElementById('tab-btn-text');
    var btnUrl = document.getElementById('tab-btn-url');
    var btnDoc = document.getElementById('tab-btn-doc');

    var activeClasses = ['bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-xs'];
    var inactiveClasses = ['text-slate-600', 'dark:text-slate-400'];

    [btnText, btnUrl, btnDoc].forEach(function(b) {
      activeClasses.forEach(function(c) { b.classList.remove(c); });
      inactiveClasses.forEach(function(c) { b.classList.add(c); });
      b.setAttribute('aria-selected', 'false');
    });

    panelUrl.classList.add('hidden');
    panelDoc.classList.add('hidden');

    if (tab === 'text') {
      activeClasses.forEach(function(c) { btnText.classList.add(c); });
      inactiveClasses.forEach(function(c) { btnText.classList.remove(c); });
      btnText.setAttribute('aria-selected', 'true');
    } else if (tab === 'url') {
      panelUrl.classList.remove('hidden');
      activeClasses.forEach(function(c) { btnUrl.classList.add(c); });
      inactiveClasses.forEach(function(c) { btnUrl.classList.remove(c); });
      btnUrl.setAttribute('aria-selected', 'true');
    } else if (tab === 'doc') {
      panelDoc.classList.remove('hidden');
      activeClasses.forEach(function(c) { btnDoc.classList.add(c); });
      inactiveClasses.forEach(function(c) { btnDoc.classList.remove(c); });
      btnDoc.setAttribute('aria-selected', 'true');
    }
  }

  function handleJobDescriptionChange(text) {
    var counter = document.getElementById('job-char-counter');
    if (counter) {
      counter.innerText = text.length + ' caracteres';
    }
    var matchInput = document.getElementById('match-job-desc');
    if (matchInput) { matchInput.value = text; }
    var chatJobDesc = document.getElementById('chat-job-desc');
    if (chatJobDesc) { chatJobDesc.value = text; }
  }

  function selectSkill(slug) {
    activeSkill = slug;
    var cards = document.querySelectorAll('.skill-card');
    cards.forEach(function(card) {
      card.classList.remove('border-indigo-600', 'bg-indigo-50/50', 'dark:bg-indigo-950/30', 'dark:border-indigo-500');
      card.classList.add('border-slate-200', 'dark:border-slate-800');
    });
    var activeCard = document.getElementById('card-' + slug);
    if (activeCard) {
      activeCard.classList.remove('border-slate-200', 'dark:border-slate-800');
      activeCard.classList.add('border-indigo-600', 'bg-indigo-50/50', 'dark:bg-indigo-950/30', 'dark:border-indigo-500');
    }
    var chatSkillInput = document.getElementById('chat-skill-slug');
    if (chatSkillInput) { chatSkillInput.value = slug; }
  }

  function triggerResumeSynthesis() {
    var jobDesc = document.getElementById('job-description-input').value.trim();
    if (!jobDesc) {
      alert('Por favor, informe a descrição da vaga antes de solicitar a síntese.');
      return;
    }
    // Dispara a síntese do currículo via POST para criar ou redirecionar
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/resumes/generate-custom';
    var inputDesc = document.createElement('input');
    inputDesc.type = 'hidden';
    inputDesc.name = 'job_description';
    inputDesc.value = jobDesc;
    form.appendChild(inputDesc);

    var inputSkill = document.createElement('input');
    inputSkill.type = 'hidden';
    inputSkill.name = 'prompt_skill_slug';
    inputSkill.value = activeSkill;
    form.appendChild(inputSkill);

    document.body.appendChild(form);
    form.submit();
  }
</script>
{% endblock %}
