<div id="auth-modal-card" class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-5 animate-in fade-in zoom-in duration-150">
    <!-- Botão Fechar (X) -->
    <button type="button" 
            onclick="closeModal()" 
            aria-label="Fechar modal"
            class="absolute top-4 right-4 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>

    <!-- Cabeçalho -->
    <div class="text-center space-y-1.5">
        <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 mb-0.5">
            <img src="/static/img/logo.jpg" alt="Logo ThothSCV" class="w-7 h-7 rounded-lg object-contain">
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Recuperar Senha
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            Informe seu e-mail para receber as instruções de recuperação
        </p>
    </div>

    {% if success %}
    <!-- Mensagem de Sucesso -->
    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-900 text-center space-y-2.5">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900 text-emerald-600 dark:text-emerald-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
        </div>
        <p class="text-xs font-bold text-emerald-800 dark:text-emerald-200">
            E-mail de recuperação enviado!
        </p>
        <p class="text-[11px] text-emerald-700 dark:text-emerald-300">
            Se houver uma conta associada a <strong>{{ email }}</strong>, enviamos um link para redefinir sua senha.
        </p>
    </div>

    <button type="button" 
            hx-get="/auth/login-view" 
            hx-target="#auth-modal-card" 
            hx-swap="outerHTML"
            class="w-full h-10 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors shadow cursor-pointer">
        Voltar para o Login
    </button>
    {% else %}

    <!-- Banner de Erro (se houver) -->
    {% if error %}
    <div class="p-3 rounded-xl bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-900 text-xs font-medium text-red-700 dark:text-red-400 flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Formulário -->
    <form hx-post="/auth/forgot-password" hx-target="#auth-modal-card" hx-swap="outerHTML" class="space-y-3.5">
        <div class="space-y-1">
            <label for="forgot-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                E-mail cadastrado
            </label>
            <input type="email" 
                   id="forgot-email" 
                   name="email" 
                   value="{{ email or '' }}"
                   required 
                   placeholder="seu@email.com"
                   class="w-full h-9 px-3 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-400 transition-all">
        </div>

        <button type="submit" 
                id="btn-submit-forgot"
                class="w-full h-10 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors shadow cursor-pointer mt-1">
            Enviar link de recuperação
        </button>
    </form>

    <!-- Rodapé -->
    <div class="text-center pt-1 border-t border-slate-100 dark:border-slate-800/80">
        <button type="button" 
                hx-get="/auth/login-view" 
                hx-target="#auth-modal-card" 
                hx-swap="outerHTML"
                class="text-xs font-medium text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors cursor-pointer">
            ← Voltar para o login
        </button>
    </div>
    {% endif %}
</div>
