<div id="auth-modal-card" class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-5 animate-in fade-in zoom-in duration-150">
    <!-- Botão Fechar (X) -->
    <button type="button" 
            onclick="closeModal()" 
            aria-label="Fechar modal"
            class="absolute top-4 right-4 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>

    <!-- Cabeçalho -->
    <div class="text-center space-y-1.5">
        <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 mb-0.5">
            <img src="/static/img/logo.jpg" alt="Logo ThothSCV" class="w-7 h-7 rounded-lg object-contain">
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Criar Conta
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            Comece a gerenciar seus currículos com inteligência artificial
        </p>
    </div>

    <!-- Banner de Erro (se houver) -->
    {% if error %}
    <div class="p-3 rounded-xl bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-900 text-xs font-medium text-red-700 dark:text-red-400 flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>{{ error }}</span>
    </div>
    {% endif %}

    <!-- Botões de Login Social Rápido -->
    <div class="grid grid-cols-2 gap-2.5">
        <button type="button" 
                id="btn-register-google"
                class="flex items-center justify-center gap-2 h-10 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-colors shadow-sm cursor-pointer">
            <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.17 0 9.98 0 12s.45 3.83 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Google</span>
        </button>

        <button type="button" 
                id="btn-register-linkedin"
                class="flex items-center justify-center gap-2 h-10 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-colors shadow-sm cursor-pointer">
            <svg class="w-4 h-4 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
            <span>LinkedIn</span>
        </button>
    </div>

    <!-- Divisor -->
    <div class="relative flex items-center justify-center">
        <div class="w-full border-t border-slate-200 dark:border-slate-800"></div>
        <span class="absolute bg-white dark:bg-slate-900 px-3 text-[10px] font-medium tracking-wider uppercase text-slate-400">
            ou com e-mail
        </span>
    </div>

    <!-- Formulário de Cadastro -->
    <form hx-post="/auth/register" hx-target="#auth-modal-card" hx-swap="outerHTML" class="space-y-3">
        <div class="space-y-1">
            <label for="reg-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Nome Completo
            </label>
            <input type="text" 
                   id="reg-name" 
                   name="full_name" 
                   value="{{ full_name or '' }}"
                   required 
                   placeholder="Seu Nome Completo"
                   class="w-full h-9 px-3 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-400 transition-all">
        </div>

        <div class="space-y-1">
            <label for="reg-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                E-mail
            </label>
            <input type="email" 
                   id="reg-email" 
                   name="email" 
                   value="{{ email or '' }}"
                   required 
                   placeholder="seu@email.com"
                   class="w-full h-9 px-3 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-400 transition-all">
        </div>

        <div class="grid grid-cols-2 gap-2">
            <div class="space-y-1">
                <label for="reg-password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Senha
                </label>
                <input type="password" 
                       id="reg-password" 
                       name="password" 
                       required 
                       placeholder="Mínimo 6 dígitos"
                       class="w-full h-9 px-3 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-400 transition-all">
            </div>
            <div class="space-y-1">
                <label for="reg-password-confirm" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Confirmar Senha
                </label>
                <input type="password" 
                       id="reg-password-confirm" 
                       name="password_confirm" 
                       required 
                       placeholder="Repita a senha"
                       class="w-full h-9 px-3 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-400 transition-all">
            </div>
        </div>

        <button type="submit" 
                id="btn-submit-register"
                class="w-full h-10 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors shadow cursor-pointer mt-2">
            Criar Conta
        </button>
    </form>

    <!-- Rodapé -->
    <div class="text-center pt-1 border-t border-slate-100 dark:border-slate-800/80">
        <p class="text-xs text-slate-500 dark:text-slate-400">
            Já tem uma conta? 
            <button type="button" 
                    hx-get="/auth/login-view" 
                    hx-target="#auth-modal-card" 
                    hx-swap="outerHTML"
                    class="font-semibold text-slate-900 dark:text-slate-100 underline underline-offset-2 hover:text-slate-700 dark:hover:text-slate-300 transition-colors cursor-pointer">
                Entrar
            </button>
        </p>
    </div>
</div>
