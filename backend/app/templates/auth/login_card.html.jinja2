<div id="auth-modal-card" class="relative w-full max-w-sm bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 space-y-6 animate-in fade-in zoom-in duration-150">
    <!-- Botão Fechar (X) -->
    <button type="button" 
            onclick="closeModal()" 
            aria-label="Fechar modal"
            class="absolute top-4 right-4 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>

    <!-- Cabeçalho -->
    <div class="text-center space-y-1.5">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 mb-1">
            <img src="/static/img/logo.jpg" alt="Logo ThothSCV" class="w-8 h-8 rounded-lg object-contain">
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Acessar Plataforma
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            Selecione como deseja entrar na sua conta
        </p>
    </div>

    <!-- Botões de Login Social -->
    <div class="space-y-3 pt-1">
        <!-- Google -->
        <a href="/auth/login/google" 
           id="btn-login-google"
           class="w-full flex items-center justify-center gap-3 h-11 px-4 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-colors shadow-sm cursor-pointer">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.17 0 9.98 0 12s.45 3.83 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Continuar com o Google</span>
        </a>

        <!-- LinkedIn -->
        <button type="button" 
                id="btn-login-linkedin"
                hx-post="/auth/login/linkedin"
                hx-swap="none"
                class="w-full flex items-center justify-center gap-3 h-11 px-4 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-colors shadow-sm cursor-pointer">
            <svg class="w-4 h-4 shrink-0 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
            <span>Continuar com o LinkedIn</span>
        </button>
    </div>

    <!-- Rodapé: Termos e Privacidade -->
    <div class="text-center pt-2 border-t border-slate-100 dark:border-slate-800/80">
        <p class="text-[11px] leading-relaxed text-slate-400 dark:text-slate-500">
            Ao continuar, você concorda com nossos Termos de Serviço e Política de Privacidade.
        </p>
    </div>
</div>
